<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - POS Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Prompt:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body { 
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            font-family: 'Prompt', 'Inter', sans-serif; 
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            padding: 40px;
            width: 100%;
            max-width: 400px;
            text-align: center;
        }
        .pin-input {
            font-size: 2rem;
            letter-spacing: 0.5rem;
            text-align: center;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            border-radius: 10px;
        }
        .pin-input:focus {
            background: rgba(255,255,255,0.15);
            color: white;
            box-shadow: none;
            border-color: #06b6d4;
        }
        .numpad-btn {
            font-size: 1.5rem;
            width: 70px;
            height: 70px;
            border-radius: 50%;
            margin: 5px;
            background: rgba(255,255,255,0.1);
            color: white;
            border: 1px solid rgba(255,255,255,0.1);
            transition: all 0.2s;
        }
        .numpad-btn:hover, .numpad-btn:active {
            background: #06b6d4;
            border-color: #06b6d4;
        }
        .login-btn {
            background: #a855f7;
            border: none;
            padding: 12px;
            font-size: 1.2rem;
            border-radius: 10px;
            transition: background 0.3s;
        }
        .login-btn:hover {
            background: #9333ea;
        }
    </style>
</head>
<body>
    <div class="glass-card">
        <h2 class="mb-4" style="font-weight: 600;">🔐 เข้าสู่ระบบ</h2>
        
        

        <form method="POST" action="/login">
            <input type="password" name="pin" id="pinInput" class="form-control pin-input mb-4" placeholder="••••" required readonly>
            
            <div class="d-flex justify-content-center flex-wrap mb-4" style="max-width: 260px; margin: 0 auto;">
                <button type="button" class="btn numpad-btn" onclick="addPin('1')">1</button>
                <button type="button" class="btn numpad-btn" onclick="addPin('2')">2</button>
                <button type="button" class="btn numpad-btn" onclick="addPin('3')">3</button>
                <button type="button" class="btn numpad-btn" onclick="addPin('4')">4</button>
                <button type="button" class="btn numpad-btn" onclick="addPin('5')">5</button>
                <button type="button" class="btn numpad-btn" onclick="addPin('6')">6</button>
                <button type="button" class="btn numpad-btn" onclick="addPin('7')">7</button>
                <button type="button" class="btn numpad-btn" onclick="addPin('8')">8</button>
                <button type="button" class="btn numpad-btn" onclick="addPin('9')">9</button>
                <button type="button" class="btn numpad-btn text-danger" onclick="clearPin()">C</button>
                <button type="button" class="btn numpad-btn" onclick="addPin('0')">0</button>
                <button type="button" class="btn numpad-btn text-warning" onclick="backspacePin()">⌫</button>
            </div>

            <button type="submit" class="btn btn-primary w-100 login-btn">Login</button>
        </form>
    </div>

    <script>
        const pinInput = document.getElementById('pinInput');
        function addPin(num) {
            if (pinInput.value.length < 10) pinInput.value += num;
        }
        function clearPin() {
            pinInput.value = '';
        }
        function backspacePin() {
            pinInput.value = pinInput.value.slice(0, -1);
        }
    </script>
</body>
</html>